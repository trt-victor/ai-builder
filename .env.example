# Copy to .env for local use: `node --env-file=.env server.js`. Never commit .env.

# PORT=4280
# DEV_USER=you@ey.com              # local only: who you are when AUTH is not set
# REIMAGINE_URL=http://localhost:4173   # origin of the Process Reimagination app (the only origin imports are accepted from)

# Hosted (Azure App Service with authentication switched on):
# AUTH=entra
# DATABASE_URL=postgres://user:password@server.postgres.database.azure.com:5432/aibuilder

# Coach (optional; without any of these the coach runs in guide mode)
# ANTHROPIC_API_KEY=
# MODEL=claude-opus-5-5
# OLLAMA_URL=http://127.0.0.1:11434

# Kosanima knowledge repositories
# KNOWLEDGE_ROOT=../knowledge            # where new repositories are created
# KNOWLEDGE_GITHUB_OWNER=my-org          # set to also create a private GitHub repo and push (needs the gh CLI signed in)
# KOSANIMA_BIN=apg
